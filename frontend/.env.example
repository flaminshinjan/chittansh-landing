# Backend API (plan_builder).
NEXT_PUBLIC_API_URL=http://localhost:8787

# Sanity CMS — required to render demos + ship log.
# Get these from https://www.sanity.io/manage after creating a project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-only: required for `npm run seed` and any future write paths.
# Create an "Editor" token at https://www.sanity.io/manage → API → Tokens.
SANITY_WRITE_TOKEN=
